{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:nfl-auto-advance": "esbuild src/lib/nfl-auto-advance.test.ts --bundle --platform=node --format=esm --outfile=/tmp/nfl-auto-advance.test.mjs && node --test /tmp/nfl-auto-advance.test.mjs",
    "test:ndp-lock": "esbuild src/lib/ndp-lock.test.ts --bundle --platform=node --format=esm --outfile=/tmp/ndp-lock.test.mjs && node --test /tmp/ndp-lock.test.mjs",
    "test:pool-start": "esbuild src/lib/pool-start.test.ts --bundle --platform=node --format=esm --outfile=/tmp/pool-start.test.mjs && node --test /tmp/pool-start.test.mjs",
    "test:pick-reminders": "esbuild src/lib/pick-reminders.test.ts --bundle --platform=node --format=esm --outfile=/tmp/pick-reminders.test.mjs && node --test /tmp/pick-reminders.test.mjs",
    "test:survivor-week-settlement": "esbuild src/lib/survivor-week-settlement.test.ts --bundle --platform=node --format=esm --outfile=/tmp/survivor-week-settlement.test.mjs && node --test /tmp/survivor-week-settlement.test.mjs",
    "test:pick-reminders-integration": "esbuild src/lib/pick-reminders.integration.test.ts --bundle --platform=node --format=cjs --external:pino --external:pino-pretty --outfile=.pick-reminders.integration.test.cjs || exit $?; node --test .pick-reminders.integration.test.cjs; status=$?; rm -f .pick-reminders.integration.test.cjs; exit $status"
  },
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.9",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "resend": "^6.25.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
